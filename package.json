{
  "name": "@seungwoolee/agent-tree",
  "version": "0.4.0",
  "description": "Discover, navigate and export Claude Code and Codex sessions, with resume prompts for your terminal or MCP client.",
  "license": "MIT",
  "author": "Seungwoo Lee",
  "homepage": "https://github.com/lifrary/agent-tree",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifrary/agent-tree.git"
  },
  "bugs": {
    "url": "https://github.com/lifrary/agent-tree/issues"
  },
  "type": "module",
  "bin": {
    "agent-tree": "./dist/cli.js",
    "atree": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist/",
    ".claude-plugin/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node node_modules/typescript-native/bin/tsc --noEmit --watch",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "typecheck:legacy": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "cli": "tsx src/cli.ts",
    "check:release": "node scripts/check-release.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run typecheck:legacy && npm test && npm run build && npm run check:release"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "commander": "^15.0.0",
    "js-yaml": "^5.4.2",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.131.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "typescript-eslint": "^8.71.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "mindmap",
    "session",
    "visualizer",
    "cli"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
